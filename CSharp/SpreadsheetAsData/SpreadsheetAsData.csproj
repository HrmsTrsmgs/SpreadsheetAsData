<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Marimo.SpreadsheetAsData</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Marimo.SpreadsheetAsData.Core</PackageId>
    <Description>Reads and writes Excel workbook data through workbook, worksheet, cell range, and typed table APIs.</Description>
    <PackageTags>excel;spreadsheet;openxml;table;xlsx</PackageTags>
  </PropertyGroup>

  <Import Project="..\SpreadsheetAsData.PackageMetadata.props" />

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="System.Interactive" Version="7.0.1" />
  </ItemGroup>

</Project>
