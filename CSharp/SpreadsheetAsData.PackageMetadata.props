<Project>

  <PropertyGroup>
    <Version>0.4.0</Version>
    <Authors>HrmsTrsmgs</Authors>
    <_SpreadsheetAsDataRepositoryUrl>https://github.com/HrmsTrsmgs/SpreadsheetAsData</_SpreadsheetAsDataRepositoryUrl>
    <PackageProjectUrl>$(_SpreadsheetAsDataRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(_SpreadsheetAsDataRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
