<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Marimo.SpreadsheetAsData.CodeGeneration.Test</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\テスト共通\TemporaryExcelFilePaths.cs" Link="テスト補助\TemporaryExcelFilePaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\TestData\コード生成\**\*.xlsx" Link="TestData\コード生成\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\TestData\テーブル.xlsx" Link="TestData\テーブル.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\TestData\テーブル範囲属性省略.xlsx" Link="TestData\テーブル範囲属性省略.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <!-- 併用テストのオフライン復元用。テスト本体の参照やビルドには取り込みません。 -->
    <PackageReference Include="Marimo.DocumentAsData" Version="0.3.0" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpreadsheetAsData\SpreadsheetAsData.csproj" />
    <ProjectReference Include="..\SpreadsheetAsData.Build\SpreadsheetAsData.Build.csproj" />
    <ProjectReference Include="..\SpreadsheetAsData.CodeGeneration\SpreadsheetAsData.CodeGeneration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- テストの実行環境に合わせ、Visual Studio でビルドする場合も .NET SDK のアセンブリを参照します。 -->
    <Reference Include="Microsoft.Build.Framework">
      <HintPath>$(NetCoreSdkRoot)Microsoft.Build.Framework.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Build.Utilities.Core">
      <HintPath>$(NetCoreSdkRoot)Microsoft.Build.Utilities.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
